# syntax=docker/dockerfile:1

FROM rust:1.85-bookworm AS builder
WORKDIR /workspace

COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY web ./web

RUN cargo build --locked --release --package slotbound-api

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /app --create-home slotbound

COPY --from=builder /workspace/target/release/slotbound-api /usr/local/bin/slotbound-api

ENV PORT=8080
USER 10001:10001
EXPOSE 8080
CMD ["/usr/local/bin/slotbound-api"]
